# Copy to .env.local for development; set the same names in Vercel for each
# deployment. Never commit real values.

# Which clinic this deployment serves (a folder in content/)
CLINIC=azira

# --- Where leads go -----------------------------------------------------------
# Comma-separated: email, webhook, ghl (any mix). In production, leaving this
# empty makes the form tell visitors to call instead (leads are never dropped
# quietly).
LEAD_DESTINATIONS=ghl,email

# email: Resend (https://resend.com). LEAD_EMAIL_FROM must use a domain verified
# in Resend. LEAD_EMAIL_TO can be a comma-separated list.
RESEND_API_KEY=
LEAD_EMAIL_FROM="Azira enquiries <enquiries@example.com>"
LEAD_EMAIL_TO=

# webhook: JSON POST to a Google Sheet (Apps Script web app), a GoHighLevel
# inbound webhook, or Zapier/Make. See docs/TRACKING.md.
LEAD_WEBHOOK_URL=
# Optional: sent as the x-lead-secret header so the receiver can check it
LEAD_WEBHOOK_SECRET=

# ghl: straight into GoHighLevel (API v3). Create a Private Integration in the
# clinic's sub-account (Settings → Private Integrations) with the scopes
# contacts.write, opportunities.write and opportunities.readonly.
GHL_PRIVATE_TOKEN=
# Sub-account (location) id, from the URL: /v2/location/<id>/...
GHL_LOCATION_ID=
# The "Ads" pipeline and the stage new leads land in
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=
# Optional JSON: lead field → contact custom field id, to file tracking in
# custom fields as well as the note. Keys: gclid, fbclid, utm_source,
# utm_medium, utm_campaign, utm_term, utm_content, ad_group, landing_page,
# page, concern_page, concern, treated_before, start_when
GHL_CONTACT_FIELDS=

# --- Search -------------------------------------------------------------------
# Set to 1 on production once the treatment subdomains are live, so pages with
# meta.index can be indexed. Leave unset on previews.
SITE_INDEXING=
# Origin for pages without their own subdomain (defaults to the Vercel
# production URL)
SITE_URL=

# --- Meta ---------------------------------------------------------------------
# Pixel ID (digits only). Loads only after the visitor accepts cookies.
NEXT_PUBLIC_META_PIXEL_ID=
# Content of the facebook-domain-verification meta tag from Business Manager
META_DOMAIN_VERIFICATION=
